{
  "name": "devenv-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test:client": "jest --config projects/client/jest.config.cjs --runInBand",
    "test:client:coverage": "jest --config projects/client/jest.config.cjs --coverage --runInBand",
    "test:server": "jest --config projects/server/jest.config.cjs --runInBand",
    "test:server:coverage": "jest --config projects/server/jest.config.cjs --coverage --runInBand",
    "test:all": "npm run test:client && npm run test:server",
    "test:all:coverage": "npm run test:client:coverage && npm run test:server:coverage"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.1.7",
    "@angular/cdk": "^19.1.5",
    "@angular/common": "^19.1.7",
    "@angular/compiler": "^19.1.7",
    "@angular/core": "^19.1.7",
    "@angular/forms": "^19.2.14",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.1.7",
    "@angular/platform-browser-dynamic": "^19.2.14",
    "@angular/router": "^19.2.14",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "monaco-editor": "^0.52.2",
    "ngx-monaco-editor-v2": "^19.0.2",
    "rubico": "^2.7.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "jasmine-core": "~5.4.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.6.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "~5.7.3"
  }
}
